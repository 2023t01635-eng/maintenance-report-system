generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  MACHINE_OPERATOR
  SERVICE_PROVIDER
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum AlertType {
  MACHINE_WARRANTY
  PART_WARRANTY
  PART_REPLACEMENT
  MAINTENANCE_DUE
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkOrderStatus {
  DRAFT
  PENDING_OPERATOR_APPROVAL
  APPROVED
  SENT_TO_PROVIDER
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvidenceType {
  SERVICE_REPORT
  INVOICE
  PAYMENT_SLIP
  PHOTO
  OTHER
}

model User {
  id                   String      @id @default(uuid())
  name                 String
  email                String      @unique
  passwordHash         String
  role                 Role
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  assignedMachines     Machine[]   @relation("OperatorMachines")
  providerWorkOrders   WorkOrder[] @relation("ProviderWorkOrders")
  approvedWorkOrders   WorkOrder[] @relation("OperatorApprovedWorkOrders")
  auditLogs            AuditLog[]  @relation("ActorAuditLogs")

  @@index([role])
  @@index([isActive])
}

model Machine {
  id            String            @id @default(uuid())
  assetCode     String            @unique
  name          String
  category      String
  location      String
  manufacturer  String?
  model         String?
  serialNumber  String?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status        MachineStatus     @default(ACTIVE)
  operatorId    String?
  operator      User?             @relation("OperatorMachines", fields: [operatorId], references: [id])
  parts         MachinePart[]
  plans         MaintenancePlan[]
  alerts        Alert[]
  workOrders    WorkOrder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([operatorId])
  @@index([status])
  @@index([warrantyEnd])
}

model MachinePart {
  id             String      @id @default(uuid())
  machineId      String
  machine        Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name           String
  partNumber     String?
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  replacementDue DateTime?
  quantity       Int         @default(1)
  alerts         Alert[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([machineId])
  @@index([warrantyEnd])
  @@index([replacementDue])
}

model MaintenancePlan {
  id            String               @id @default(uuid())
  machineId     String
  machine       Machine              @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  frequency     MaintenanceFrequency
  intervalDays  Int?
  nextDueDate   DateTime
  thresholdDays Int                  @default(7)
  isActive      Boolean              @default(true)
  alerts        Alert[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([machineId])
  @@index([nextDueDate])
  @@index([isActive])
}

model Alert {
  id             String           @id @default(uuid())
  machineId      String?
  machine        Machine?         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  partId         String?
  part           MachinePart?     @relation(fields: [partId], references: [id], onDelete: Cascade)
  planId         String?
  plan           MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  type           AlertType
  status         AlertStatus      @default(OPEN)
  dueDate        DateTime
  message        String
  dedupeKey      String           @unique
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([machineId])
  @@index([partId])
  @@index([planId])
  @@index([status])
  @@index([dueDate])
}

model WorkOrder {
  id                   String          @id @default(uuid())
  machineId            String
  machine              Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  providerId           String?
  provider             User?           @relation("ProviderWorkOrders", fields: [providerId], references: [id])
  approvedByOperatorId String?
  approvedByOperator   User?           @relation("OperatorApprovedWorkOrders", fields: [approvedByOperatorId], references: [id])
  title                String
  description          String?
  status               WorkOrderStatus @default(DRAFT)
  scheduledDate        DateTime?
  completedDate        DateTime?
  cost                 Decimal?        @db.Decimal(12, 2)
  notes                String?
  evidence             ServiceEvidence[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([machineId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledDate])
}

model ServiceEvidence {
  id          String       @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        EvidenceType
  fileName    String
  fileUrl     String?
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([workOrderId])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}
