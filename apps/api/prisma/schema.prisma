generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  MACHINE_OPERATOR
  SERVICE_PROVIDER
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum AlertType {
  MACHINE_WARRANTY
  PART_WARRANTY
  PART_REPLACEMENT
  MAINTENANCE_DUE
  PAYMENT_APPROVAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkOrderStatus {
  DRAFT
  PENDING_OPERATOR_APPROVAL
  APPROVED
  PENDING_MANAGEMENT_APPROVAL
  SENT_TO_PROVIDER
  PROVIDER_ACCEPTED
  IN_PROGRESS
  PRICE_REVISION_REQUESTED
  COMPLETED
  AWAITING_PAYMENT_APPROVAL
  CLOSED
  REJECTED
  CANCELLED
}

enum WorkOrderCategory {
  BREAKDOWN_REPAIR
  PREVENTIVE_MAINTENANCE
  WARRANTY_SERVICE
  PART_REPLACEMENT
  INSPECTION
  OTHER
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EvidenceType {
  SERVICE_REPORT
  INVOICE
  PAYMENT_SLIP
  PHOTO
  OTHER
}

model User {
  id                 String      @id @default(uuid())
  name               String
  email              String      @unique
  passwordHash       String
  role               Role
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  assignedMachines   Machine[]   @relation("OperatorMachines")
  providerWorkOrders WorkOrder[] @relation("ProviderWorkOrders")
  approvedWorkOrders WorkOrder[] @relation("OperatorApprovedWorkOrders")
  createdWorkOrders  WorkOrder[] @relation("CreatedWorkOrders")
  managementApprovedWorkOrders WorkOrder[] @relation("ManagementApprovedWorkOrders")
  paymentApprovedWorkOrders WorkOrder[] @relation("PaymentApprovedWorkOrders")
  workOrderPriceCounters WorkOrderPriceCounter[] @relation("WorkOrderPriceCounterCreators")
  uploadedEvidence   ServiceEvidence[] @relation("EvidenceUploaders")
  auditLogs          AuditLog[]  @relation("ActorAuditLogs")

  @@index([role])
  @@index([isActive])
}

model Machine {
  id            String            @id @default(uuid())
  assetCode     String            @unique
  name          String
  category      String
  location      String
  manufacturer  String?
  model         String?
  serialNumber  String?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status        MachineStatus     @default(ACTIVE)
  operatorId    String?
  operator      User?             @relation("OperatorMachines", fields: [operatorId], references: [id])
  parts         MachinePart[]
  plans         MaintenancePlan[]
  alerts        Alert[]
  workOrders    WorkOrder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([operatorId])
  @@index([status])
  @@index([warrantyEnd])
}

model MachinePart {
  id             String    @id @default(uuid())
  machineId      String
  machine        Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name           String
  partNumber     String?
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  replacementDue DateTime?
  quantity       Int       @default(1)
  alerts         Alert[]
  workOrderReplacements WorkOrderReplacement[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([machineId])
  @@index([warrantyEnd])
  @@index([replacementDue])
}

model MaintenancePlan {
  id            String               @id @default(uuid())
  machineId     String
  machine       Machine              @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  frequency     MaintenanceFrequency
  intervalDays  Int?
  nextDueDate   DateTime
  thresholdDays Int                  @default(7)
  isActive      Boolean              @default(true)
  alerts        Alert[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([machineId])
  @@index([nextDueDate])
  @@index([isActive])
}

model Alert {
  id             String           @id @default(uuid())
  machineId      String?
  machine        Machine?         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  partId         String?
  part           MachinePart?     @relation(fields: [partId], references: [id], onDelete: Cascade)
  planId         String?
  plan           MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceWorkOrders WorkOrder[]     @relation("SourceAlertWorkOrders")
  paymentWorkOrderId String?       @unique
  paymentWorkOrder WorkOrder?      @relation("PaymentApprovalAlert", fields: [paymentWorkOrderId], references: [id], onDelete: Cascade)
  type           AlertType
  status         AlertStatus      @default(OPEN)
  dueDate        DateTime
  message        String
  dedupeKey      String           @unique
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([machineId])
  @@index([partId])
  @@index([planId])
  @@index([paymentWorkOrderId])
  @@index([status])
  @@index([dueDate])
}

model WorkOrder {
  id                   String            @id @default(uuid())
  machineId            String
  machine              Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  providerId           String?
  provider             User?             @relation("ProviderWorkOrders", fields: [providerId], references: [id])
  approvedByOperatorId String?
  approvedByOperator   User?             @relation("OperatorApprovedWorkOrders", fields: [approvedByOperatorId], references: [id])
  createdById          String?
  createdBy            User?             @relation("CreatedWorkOrders", fields: [createdById], references: [id])
  sourceAlertId        String?
  sourceAlert          Alert?            @relation("SourceAlertWorkOrders", fields: [sourceAlertId], references: [id])
  managementApprovedById String?
  managementApprovedBy User?             @relation("ManagementApprovedWorkOrders", fields: [managementApprovedById], references: [id])
  managementApprovedAt DateTime?
  paymentApprovedById  String?
  paymentApprovedBy    User?             @relation("PaymentApprovedWorkOrders", fields: [paymentApprovedById], references: [id])
  paymentApprovedAt    DateTime?
  paymentReference     String?
  title                String
  description          String?
  category             WorkOrderCategory @default(OTHER)
  priority             WorkOrderPriority @default(NORMAL)
  status               WorkOrderStatus   @default(DRAFT)
  scheduledDate        DateTime?
  providerAcceptedAt   DateTime?
  completionSubmittedAt DateTime?
  completedDate        DateTime?
  proposedBudget       Decimal?          @map("cost") @db.Decimal(12, 2)
  serviceCost          Decimal?          @db.Decimal(12, 2)
  replacedParts        String?
  notes                String?
  providerBusinessName String?
  providerAddress      String?
  providerRegistrationNumber String?
  providerContact      String?
  invoiceNumber        String?
  rejectionReason      String?
  replacements         WorkOrderReplacement[]
  evidence             ServiceEvidence[]
  paymentApprovalAlert Alert?            @relation("PaymentApprovalAlert")
  priceCounterOffers   WorkOrderPriceCounter[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([machineId])
  @@index([providerId])
  @@index([createdById])
  @@index([sourceAlertId])
  @@index([managementApprovedById])
  @@index([paymentApprovedById])
  @@index([status])
  @@index([scheduledDate])
}

model WorkOrderPriceCounter {
  id             String    @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User      @relation("WorkOrderPriceCounterCreators", fields: [createdById], references: [id])
  counterBudget  Decimal   @db.Decimal(12, 2)
  reviewedTotal  Decimal   @db.Decimal(12, 2)
  reason         String
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([workOrderId, createdAt])
  @@index([createdById])
}

model OrganizationProfile {
  id                 String   @id @default("primary")
  companyName        String   @default("University of Colombo - Faculty of Technology")
  address            String?
  registrationNumber String?
  phone              String?
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ServiceEvidence {
  id          String       @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        EvidenceType
  fileName    String
  fileUrl     String?
  notes       String?
  uploadedById String?
  uploadedBy  User?        @relation("EvidenceUploaders", fields: [uploadedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([workOrderId])
  @@index([type])
  @@index([uploadedById])
}

model WorkOrderReplacement {
  id                  String       @id @default(uuid())
  workOrderId         String
  workOrder           WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machinePartId       String?
  machinePart         MachinePart? @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  partName            String
  partNumber          String?
  quantity            Int          @default(1)
  unitCost            Decimal?     @db.Decimal(12, 2)
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  nextReplacementDate DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([workOrderId])
  @@index([machinePartId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}
